{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ui-action-semantics-report-v1.schema.json",
  "title": "UiActionSemanticsReportV1",
  "type": "object",
  "required": [
    "uiActionSemanticsReportVersion",
    "scene",
    "sourceUiSystemReportVersion",
    "scopePolicy",
    "focusedScreenId",
    "focusedEntityId",
    "initialFocusWidgetId",
    "screens",
    "actions",
    "warnings"
  ],
  "properties": {
    "uiActionSemanticsReportVersion": {
      "const": 1
    },
    "scene": {
      "type": "string",
      "minLength": 1
    },
    "sourceUiSystemReportVersion": {
      "const": 1
    },
    "scopePolicy": {
      "const": "topmost-active-screen"
    },
    "focusedScreenId": {
      "type": ["string", "null"]
    },
    "focusedEntityId": {
      "type": ["string", "null"]
    },
    "initialFocusWidgetId": {
      "type": ["string", "null"]
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "screenId",
          "entityId",
          "active",
          "layer",
          "inActionScope",
          "hasActionSemantics",
          "bindingCount",
          "actionCount"
        ],
        "properties": {
          "screenId": {
            "type": "string",
            "minLength": 1
          },
          "entityId": {
            "type": "string",
            "minLength": 1
          },
          "active": {
            "type": "boolean"
          },
          "layer": {
            "type": "integer"
          },
          "inActionScope": {
            "type": "boolean"
          },
          "hasActionSemantics": {
            "type": "boolean"
          },
          "bindingCount": {
            "type": "integer",
            "minimum": 0
          },
          "actionCount": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "screenId",
          "entityId",
          "widgetId",
          "kind",
          "text",
          "x",
          "y",
          "width",
          "height",
          "actionId",
          "actionIndex",
          "previousActionWidgetId",
          "nextActionWidgetId"
        ],
        "properties": {
          "screenId": {
            "type": "string",
            "minLength": 1
          },
          "entityId": {
            "type": "string",
            "minLength": 1
          },
          "widgetId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "const": "label"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "x": {
            "type": "integer"
          },
          "y": {
            "type": "integer"
          },
          "width": {
            "type": ["integer", "null"]
          },
          "height": {
            "type": ["integer", "null"]
          },
          "actionId": {
            "type": "string",
            "minLength": 1
          },
          "actionIndex": {
            "type": "integer",
            "minimum": 0
          },
          "previousActionWidgetId": {
            "type": ["string", "null"]
          },
          "nextActionWidgetId": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
