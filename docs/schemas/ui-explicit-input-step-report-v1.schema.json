{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ui-explicit-input-step-report-v1.schema.json",
  "title": "UiExplicitInputStepReportV1",
  "type": "object",
  "required": [
    "uiExplicitInputStepReportVersion",
    "scene",
    "sourceUiSystemReportVersion",
    "sourceUiNavigationFocusReportVersion",
    "sourceUiActionSemanticsReportVersion",
    "sourceUiLocalScreenStateReportVersion",
    "scopePolicy",
    "uiExplicitInputVersion",
    "uiExplicitInputTick",
    "actionType",
    "direction",
    "focusedScreenId",
    "focusedEntityId",
    "stepType",
    "inputHandled",
    "focusedActionIndexBefore",
    "focusedActionIdBefore",
    "focusedWidgetIdBefore",
    "focusedActionIndexAfter",
    "focusedActionIdAfter",
    "focusedWidgetIdAfter",
    "actionCandidates",
    "activatedActionId",
    "warnings"
  ],
  "properties": {
    "uiExplicitInputStepReportVersion": {
      "type": "integer"
    },
    "scene": {
      "type": "string"
    },
    "sourceUiSystemReportVersion": {
      "type": "integer"
    },
    "sourceUiNavigationFocusReportVersion": {
      "type": "integer"
    },
    "sourceUiActionSemanticsReportVersion": {
      "type": "integer"
    },
    "sourceUiLocalScreenStateReportVersion": {
      "type": "integer"
    },
    "scopePolicy": {
      "type": "string"
    },
    "uiExplicitInputVersion": {
      "type": "integer"
    },
    "uiExplicitInputTick": {
      "type": "integer",
      "minimum": 1
    },
    "actionType": {
      "enum": [
        "navigate",
        "activate"
      ]
    },
    "direction": {
      "type": "integer",
      "minimum": -1,
      "maximum": 1
    },
    "focusedScreenId": {},
    "focusedEntityId": {},
    "stepType": {
      "enum": [
        "noop",
        "activate",
        "focus",
        "focus-move"
      ]
    },
    "inputHandled": {
      "type": "boolean"
    },
    "focusedActionIndexBefore": {},
    "focusedActionIdBefore": {},
    "focusedWidgetIdBefore": {},
    "focusedActionIndexAfter": {},
    "focusedActionIdAfter": {},
    "focusedWidgetIdAfter": {},
    "actionCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "actionIndex",
          "actionId",
          "widgetId"
        ],
        "properties": {
          "actionIndex": {
            "type": "integer",
            "minimum": 0
          },
          "actionId": {
            "type": "string"
          },
          "widgetId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "activatedActionId": {},
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
