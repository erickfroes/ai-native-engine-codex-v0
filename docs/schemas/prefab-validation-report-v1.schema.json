{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prefab-validation-report-v1.schema.json",
  "title": "PrefabValidationReportV1",
  "type": "object",
  "required": [
    "prefabValidationReportVersion",
    "ok",
    "absolutePath",
    "prefab",
    "errors"
  ],
  "properties": {
    "prefabValidationReportVersion": {
      "const": 1
    },
    "ok": {
      "type": "boolean"
    },
    "absolutePath": {
      "type": "string",
      "minLength": 1
    },
    "prefab": {
      "type": [
        "object",
        "null"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "message"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
