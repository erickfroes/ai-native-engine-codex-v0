{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas-material-manifest-v1.schema.json",
  "title": "AtlasMaterialManifestV1",
  "type": "object",
  "required": [
    "atlasMaterialManifestVersion",
    "metadata",
    "assetManifestPath",
    "atlases",
    "materials",
    "sprites",
    "tiles"
  ],
  "properties": {
    "atlasMaterialManifestVersion": {
      "enum": [1]
    },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "assetManifestPath": {
      "type": "string",
      "minLength": 1
    },
    "atlases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "assetId",
          "regions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "assetId": {
            "type": "string",
            "minLength": 1
          },
          "regions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "x",
                "y",
                "width",
                "height"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "x": {
                  "type": "integer",
                  "minimum": 0
                },
                "y": {
                  "type": "integer",
                  "minimum": 0
                },
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "height": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "sampler",
          "alphaMode"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "sprite",
              "tile",
              "ui"
            ]
          },
          "sampler": {
            "enum": [
              "nearest",
              "linear"
            ]
          },
          "alphaMode": {
            "enum": [
              "opaque",
              "blend",
              "mask"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "sprites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "atlasId",
          "regionId",
          "materialId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "atlasId": {
            "type": "string",
            "minLength": 1
          },
          "regionId": {
            "type": "string",
            "minLength": 1
          },
          "materialId": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "tiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "atlasId",
          "regionId",
          "materialId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "atlasId": {
            "type": "string",
            "minLength": 1
          },
          "regionId": {
            "type": "string",
            "minLength": 1
          },
          "materialId": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
